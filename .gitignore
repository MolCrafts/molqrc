/target
**/*.rs.bk
*.pdb
.DS_Store

# wasm-pack output: the npm build is regenerated by CI on publish, while the
# web demo bundle IS committed so the page can be served as static files.
# wasm-pack drops a `*` .gitignore into every out-dir; ignore that file itself
# so it stops shadowing the committed demo bundle.
wasm/pkg/
molqrc_web/pkg/.gitignore
